{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "useKeyWithClickEvents": "error",
        "useMediaCaption": "off"
      }
    }
  },
  "files": {
    "includes": ["**", "!**/.aiox-core", "!**/.aiox", "!.mcp.json"]
  }
}
